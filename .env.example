PORT=5000
MONGODB_URI=mongodb://localhost:27017/campus-food-court
# Generate a unique random secret (at least 32 characters) for every environment.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Primary frontend origin. Keep this for existing deployments.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional trusted frontend origins (e.g. Vercel preview/prod URLs).
FRONTEND_URLS=
# Comma-separated email domains, without @. Use the domains actually approved for this campus.
ALLOWED_EMAIL_DOMAINS=rgipt.ac.in
# Comma-separated email addresses that should receive the admin role.
ADMIN_EMAILS=admin@example.com
# Public brand used in student push notifications.
CAMPUS_NAME=RGIPT Food Court
# Razorpay credentials; required only when payment features are enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# VAPID keys; required only when browser push notifications are enabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NODE_ENV=development
